---
// Stylised Nippon Budokan with a penlight crowd in HIMEHINA colours.
const lights = Array.from({ length: 26 }, (_, i) => {
  const x = 30 + i * 21 + (i % 3) * 4;
  const h = 26 + ((i * 37) % 22);
  const tilt = ((i * 53) % 30) - 15;
  const pink = i % 2 === 0;
  return { x, h, tilt, pink, d: ((i * 0.13) % 1.6).toFixed(2) };
});
---

<svg class="budokan-art" viewBox="0 0 600 420" role="img" aria-label="日本武道馆插画：八角形屋顶与粉蓝色应援棒">
  <defs>
    <linearGradient id="bk-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a1748"></stop>
      <stop offset="0.6" stop-color="#5b2a7c"></stop>
      <stop offset="1" stop-color="#ff7fd2"></stop>
    </linearGradient>
    <linearGradient id="bk-roof" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#3fb9ef"></stop>
      <stop offset="0.5" stop-color="#8fdcff"></stop>
      <stop offset="1" stop-color="#3fb9ef"></stop>
    </linearGradient>
    <linearGradient id="bk-wall" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff"></stop>
      <stop offset="1" stop-color="#f1e6ff"></stop>
    </linearGradient>
    <radialGradient id="bk-glow" cx="0.5" cy="0.4" r="0.6">
      <stop offset="0" stop-color="#ffd3f1" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#ffd3f1" stop-opacity="0"></stop>
    </radialGradient>
    <clipPath id="bk-clip"><rect width="600" height="420" rx="28"></rect></clipPath>
  </defs>
  <g clip-path="url(#bk-clip)">
    <rect width="600" height="420" fill="url(#bk-sky)"></rect>
    <!-- stars -->
    <g fill="#fff">
      <circle cx="60" cy="50" r="1.6" class="tw"></circle>
      <circle cx="140" cy="90" r="1.2" class="tw d2"></circle>
      <circle cx="510" cy="60" r="1.8" class="tw d3"></circle>
      <circle cx="450" cy="110" r="1.2" class="tw"></circle>
      <circle cx="560" cy="140" r="1.4" class="tw d2"></circle>
      <circle cx="90" cy="150" r="1.1" class="tw d3"></circle>
    </g>
    <!-- spotlights -->
    <g class="beams" opacity="0.5">
      <path d="M300 120 120 420h70z" fill="#ff3ac0" opacity="0.35"></path>
      <path d="M300 120 480 420h-70z" fill="#3fb9ef" opacity="0.35"></path>
    </g>
    <ellipse cx="300" cy="190" rx="260" ry="150" fill="url(#bk-glow)"></ellipse>

    <!-- giboshi finial -->
    <path d="M300 52c-9 10-11 20-6 27h12c5-7 3-17-6-27z" fill="#ffd36b"></path>
    <rect x="294" y="78" width="12" height="16" rx="2" fill="#e6b84a"></rect>
    <!-- upper roof -->
    <path d="M300 92c-40 0-80 22-118 50h236c-38-28-78-50-118-50z" fill="url(#bk-roof)"></path>
    <path d="M178 142h244l-10 12H188z" fill="#2a8fc4"></path>
    <!-- upper drum -->
    <rect x="200" y="154" width="200" height="34" fill="url(#bk-wall)"></rect>
    <g fill="#ffb6e6">
      <rect x="216" y="162" width="18" height="18" rx="3"></rect>
      <rect x="248" y="162" width="18" height="18" rx="3"></rect>
      <rect x="280" y="162" width="40" height="18" rx="3"></rect>
      <rect x="334" y="162" width="18" height="18" rx="3"></rect>
      <rect x="366" y="162" width="18" height="18" rx="3"></rect>
    </g>
    <!-- lower roof -->
    <path d="M300 186c-70 0-140 18-210 44h420c-70-26-140-44-210-44z" fill="url(#bk-roof)"></path>
    <path d="M86 230h428l-14 12H100z" fill="#2a8fc4"></path>
    <!-- main hall -->
    <rect x="120" y="242" width="360" height="92" fill="url(#bk-wall)"></rect>
    <g fill="#e7dcf5">
      <rect x="140" y="256" width="10" height="78"></rect>
      <rect x="190" y="256" width="10" height="78"></rect>
      <rect x="240" y="256" width="10" height="78"></rect>
      <rect x="350" y="256" width="10" height="78"></rect>
      <rect x="400" y="256" width="10" height="78"></rect>
      <rect x="450" y="256" width="10" height="78"></rect>
    </g>
    <rect x="268" y="270" width="64" height="64" rx="6" fill="#2a1748"></rect>
    <rect x="276" y="278" width="48" height="56" rx="4" fill="#ff7fd2" opacity="0.55" class="door"></rect>
    <text x="300" y="262" text-anchor="middle" font-size="11" font-weight="700" fill="#7a5fa0" font-family="sans-serif" letter-spacing="3">日本武道館</text>
    <!-- ground -->
    <rect x="0" y="334" width="600" height="86" fill="#1b0f30"></rect>
    <!-- penlights -->
    <g>
      {
        lights.map((l) => (
          <g transform={`translate(${l.x} 420) rotate(${l.tilt})`}>
            <g class="pl" style={`animation-delay:-${l.d}s`}>
              <rect x="-3.5" y={-l.h - 34} width="7" height={l.h} rx="3.5" fill={l.pink ? '#ff3ac0' : '#3fb9ef'} />
              <rect x="-3.5" y={-l.h - 34} width="7" height={l.h} rx="3.5" fill={l.pink ? '#ff3ac0' : '#3fb9ef'} opacity="0.5" filter="blur(6px)" />
              <rect x="-3" y="-34" width="6" height="14" rx="2" fill="#3b2a55" />
            </g>
          </g>
        ))
      }
    </g>
    <!-- crowd heads -->
    <g fill="#120a22">
      {Array.from({ length: 22 }, (_, i) => <circle cx={14 + i * 28} cy={410 - (i % 2) * 6} r="16" />)}
    </g>
  </g>
</svg>

<style>
  .budokan-art {
    width: 100%;
    height: auto;
    border-radius: 28px;
    box-shadow: var(--shadow-lg);
  }
  .tw {
    animation: tw 3s ease-in-out infinite;
  }
  .tw.d2 {
    animation-delay: -1s;
  }
  .tw.d3 {
    animation-delay: -2s;
  }
  @keyframes tw {
    50% {
      opacity: 0.2;
    }
  }
  .pl {
    transform-origin: 0 -20px;
    animation: sway 1.6s ease-in-out infinite;
  }
  @keyframes sway {
    0%,
    100% {
      transform: rotate(-10deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }
  .beams {
    transform-origin: 300px 120px;
    animation: beam 6s ease-in-out infinite;
  }
  @keyframes beam {
    50% {
      transform: rotate(6deg);
      opacity: 0.8;
    }
  }
  .door {
    animation: glow 2.4s ease-in-out infinite;
  }
  @keyframes glow {
    50% {
      opacity: 0.95;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw,
    .pl,
    .beams,
    .door {
      animation: none;
    }
  }
</style>
