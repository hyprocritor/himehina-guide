---
import type { IconName } from '../data/sections';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 56, class: cls } = Astro.props;
const id = `g-${name}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ff3ac0"></stop>
      <stop offset="1" stop-color="#3fb9ef"></stop>
    </linearGradient>
  </defs>
  <g stroke={`url(#${id})`} stroke-width="3.2">
    {
      name === 'compass' && (
        <>
          <circle cx="32" cy="32" r="24" fill="#fff0f9" />
          <path d="M40 24 35 35 24 40l5-11z" fill="#ff3ac0" stroke="none" />
          <path d="M40 24 35 35 24 40l5-11z" />
          <path d="M32 8v5M32 51v5M8 32h5M51 32h5" />
        </>
      )
    }
    {
      name === 'ticket' && (
        <>
          <path
            d="M8 20a4 4 0 0 1 4-4h40a4 4 0 0 1 4 4v6a6 6 0 0 0 0 12v6a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4v-6a6 6 0 0 0 0-12z"
            fill="#fff0f9"
          />
          <path d="M42 17v30" stroke-dasharray="3 4" />
          <path d="M18 27h16M18 33h12M18 39h14" />
        </>
      )
    }
    {
      name === 'passport' && (
        <>
          <rect x="14" y="8" width="36" height="48" rx="5" fill="#e2f5fd" />
          <circle cx="32" cy="28" r="9" />
          <path d="M23 28h18M32 19c-4 5-4 13 0 18M32 19c4 5 4 13 0 18" />
          <path d="M23 46h18" />
        </>
      )
    }
    {
      name === 'visa' && (
        <>
          <rect x="8" y="14" width="48" height="36" rx="5" fill="#fff0f9" />
          <circle cx="22" cy="30" r="6" />
          <path d="M14 43c2-5 14-5 16 0M36 26h12M36 32h12M36 38h8" />
          <circle cx="47" cy="44" r="5" fill="#3fb9ef" stroke="none" />
        </>
      )
    }
    {
      name === 'plane' && (
        <>
          <path
            d="M10 34 54 14c3-1 5 2 2 4L42 30l-2 18-6 2-4-14-9 5v7l-4 2-3-10-8-5z"
            fill="#e2f5fd"
          />
          <path d="M8 56h48" stroke-dasharray="2 6" />
        </>
      )
    }
    {
      name === 'train' && (
        <>
          <rect x="16" y="8" width="32" height="38" rx="9" fill="#e2f5fd" />
          <path d="M16 28h32M26 16h12" />
          <circle cx="24" cy="37" r="2.5" fill="#ff3ac0" stroke="none" />
          <circle cx="40" cy="37" r="2.5" fill="#ff3ac0" stroke="none" />
          <path d="M22 46 15 56M42 46l7 10M19 52h26" />
        </>
      )
    }
    {
      name === 'card' && (
        <>
          <rect x="6" y="16" width="44" height="30" rx="5" fill="#e2f5fd" />
          <path d="M6 25h44M13 37h10" />
          <rect x="38" y="26" width="20" height="32" rx="4" fill="#fff" />
          <path d="M45 52h6" />
        </>
      )
    }
    {
      name === 'stage' && (
        <>
          <path d="M6 54h52M10 54V30l22-18 22 18v24" fill="#fff0f9" />
          <path d="M22 54V38h20v16" />
          <path d="M32 12V5M24 6l3 4M40 6l-3 4" />
        </>
      )
    }
    {
      name === 'merch' && (
        <>
          <path d="M14 22h36l-3 34H17z" fill="#fff0f9" />
          <path d="M24 22v-4a8 8 0 0 1 16 0v4" />
          <path d="M32 33l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z" fill="#3fb9ef" stroke="none" />
        </>
      )
    }
    {
      name === 'bouquet' && (
        <>
          <path d="M20 36h24l-5 20H25z" fill="#e2f5fd" />
          <path d="M32 36V26" />
          <circle cx="32" cy="18" r="7" fill="#fff0f9" />
          <circle cx="20" cy="25" r="6" fill="#fff0f9" />
          <circle cx="44" cy="25" r="6" fill="#fff0f9" />
          <circle cx="32" cy="18" r="2.5" fill="#ff3ac0" stroke="none" />
          <path d="M23 30l5 6M41 30l-5 6M24 44h16" />
        </>
      )
    }
    {
      name === 'check' && (
        <>
          <rect x="12" y="8" width="40" height="48" rx="6" fill="#e2f5fd" />
          <path d="M20 22l3 3 6-6M20 34l3 3 6-6M20 46l3 3 6-6M34 23h10M34 35h10M34 47h10" />
        </>
      )
    }
    {
      name === 'book' && (
        <>
          <path d="M8 14c8-3 16-3 24 2 8-5 16-5 24-2v38c-8-3-16-3-24 2-8-5-16-5-24-2z" fill="#fff0f9" />
          <path d="M32 16v38" />
        </>
      )
    }
  </g>
</svg>
