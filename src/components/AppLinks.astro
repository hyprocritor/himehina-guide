---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const IOS = 'https://apps.apple.com/jp/app/id1175974437';
const ANDROID = 'https://play.google.com/store/apps/details?id=jp.lhe.ebillet';
---

<div class:list={['apl', { compact }]}>
  <p class="apl-title">下载「ローチケ電子チケット」App（官方，免费）</p>
  <div class="apl-btns">
    <a class="store ios" href={IOS} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.2 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.5-3.8zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.5 2.8-1.3z"
        ></path></svg
      >
      <span><small>iPhone</small>App Store</span>
    </a>
    <a class="store android" href={ANDROID} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
        ><path fill="#00d7fe" d="M3.6 2.3 13.4 12l-9.8 9.7c-.4-.2-.6-.6-.6-1.1V3.4c0-.5.2-.9.6-1.1z"></path><path
          fill="#00f076"
          d="m16.8 8.6-3.4 3.4-9.8-9.7c.2-.1.5-.2.8-.1l12.4 6.4z"></path><path
          fill="#ff3a44"
          d="m16.8 15.4-12.4 6.4c-.3.1-.6 0-.8-.1l9.8-9.7 3.4 3.4z"></path><path
          fill="#ffd400"
          d="m20.4 13.5-3.6 1.9-3.4-3.4 3.4-3.4 3.6 1.9c.9.5.9 1.5 0 3z"></path></svg
      >
      <span><small>Android</small>Google Play</span>
    </a>
  </div>
  <div class="apl-warn">
    <b>⚠ 只在日本区上架</b>
    <ul>
      <li><b>iPhone：</b>中国区 App Store 搜不到，需要用<b>日本区 Apple ID</b> 登录 App Store 才能下载</li>
      <li><b>Android：</b>需要有 Google Play，并且账号地区是日本。国行安卓手机大多没有 Google Play 服务，可能装不上或用不了</li>
      <li>不要从第三方网站下载 APK 安装包，来路不明的版本可能无法认证，也有安全风险</li>
      <li>装好后先用日本号码完成短信认证，确认这台手机能正常使用，再去申请</li>
    </ul>
  </div>
</div>

<style>
  .apl {
    margin: 16px 0;
    padding: 16px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }

  .apl.compact {
    margin: 12px 0;
    padding: 12px;
    background: #faf7fd;
  }

  .apl-title {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .apl-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px 7px 12px;
    border-radius: 12px;
    background: #111;
    color: #fff;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .store:hover {
    transform: translateY(-2px);
  }

  .store span {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    font-weight: 700;
    font-size: 0.98rem;
  }

  .store small {
    font-weight: 500;
    font-size: 0.66rem;
    opacity: 0.8;
  }

  .apl-warn {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--warn-soft);
    color: #8a3205;
    font-size: 0.88rem;
  }

  .apl-warn ul {
    margin: 4px 0 0;
    padding-left: 1.2em;
    display: grid;
    gap: 3px;
  }
</style>
