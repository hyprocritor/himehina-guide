---
import Guide from '../layouts/Guide.astro';
import Sec from '../components/Sec.astro';
import Ref from '../components/Ref.astro';

const priority = ['演出前留够时间', '到达时间别太早太晚', '尽量少转机', '到酒店方便', '算上行李费的总价', '能不能退改'];

const areas = [
  { name: '九段下', x: 300, y: 200, r: 34, main: true, d: '演出日最省心，散场后少换乘' },
  { name: '神保町', x: 382, y: 238, r: 24, d: '半藏门线一站／也可步行' },
  { name: '饭田桥·水道桥', x: 262, y: 104, r: 26, d: '东西线一站；水道桥 ≠ 九段下' },
  { name: '新宿', x: 96, y: 186, r: 26, d: '都营新宿线直达' },
  { name: '涩谷', x: 120, y: 330, r: 24, d: '半藏门线直达' },
  { name: '东京站·日本桥', x: 470, y: 300, r: 26, d: '东西线；方便去机场' },
  { name: '上野·日暮里', x: 470, y: 70, r: 24, d: '成田 Skyliner 终点方向' },
];

const rooms = [
  { jp: 'シングル', en: 'Single', cn: '单人间', bed: 'single', width: '约 90–120 cm', ppl: '1 人', d: '一张小床。两个人别订这个，酒店也不让。' },
  { jp: 'セミダブル', en: 'Semi-double', cn: '小双人床', bed: 'semi', width: '约 120–140 cm', ppl: '1 人住宽敞', d: '比国内的双人床窄不少。两个人能睡，但会很挤。' },
  { jp: 'ダブル', en: 'Double', cn: '大床房', bed: 'double', width: '约 140–160 cm', ppl: '2 人', d: '一张双人床，适合情侣、很熟的朋友。' },
  { jp: 'ツイン', en: 'Twin', cn: '双床房', bed: 'twin', width: '两张单人床', ppl: '2 人', d: '朋友一起住选这个，各睡各的床。' },
  { jp: 'トリプル', en: 'Triple', cn: '三人间', bed: 'triple', width: '三张床，或两床 + 加床', ppl: '3 人', d: '三个人合住最省钱，但房间不多，要早订。' },
  { jp: '和室', en: 'Japanese-style', cn: '日式房', bed: 'washitsu', width: '榻榻米上铺被褥（布団）', ppl: '2–5 人', d: '睡地铺，人多时很划算。晚上铺被子、早上收起来。' },
];

const terms = [
  { jp: '〇名利用', cn: '几个人住', d: '日本酒店常按人数收费，同一间房 1 人住和 2 人住价格不同，人数一定要填对' },
  { jp: '禁煙／喫煙', cn: '禁烟房／吸烟房', d: '不抽烟就选禁煙，吸烟房会有烟味' },
  { jp: '素泊まり', cn: '不含早餐', d: '只住宿，不带餐' },
  { jp: '朝食付き', cn: '含早餐', d: '多付一点钱，早上在酒店吃' },
  { jp: 'ベッド幅', cn: '床宽', d: '单位是 cm，两个人睡最好 140 cm 以上' },
  { jp: '〇〇㎡', cn: '房间面积', d: '东京商务酒店单人间常常只有十几平方米' },
  { jp: 'ユニットバス', cn: '一体式小浴室', d: '马桶、洗手台、浴缸挤在一起，很小' },
  { jp: '大浴場', cn: '公共大浴池', d: '男女分开的大澡堂，要脱光进去泡' },
  { jp: '添い寝', cn: '小孩不占床', d: '小孩和大人睡一张床，有的免费' },
];

const stays = [
  {
    jp: 'ビジネスホテル', cn: '商务酒店', tag: '最推荐', tone: 'ok',
    pros: ['房间小但干净，什么都有', '车站附近很多，价格适中', '有前台，有的有中文服务'],
    cons: ['房间和浴室都小，大箱子可能打不开'],
    fit: '第一次去日本、来看演出的大多数人',
  },
  {
    jp: 'カプセルホテル', cn: '胶囊旅馆', tag: '省钱', tone: 'blue',
    pros: ['价格比商务酒店便宜很多', '一个人住、只睡一两晚很方便', '一般有大浴场、洗漱用品'],
    cons: ['只是一个约 1 × 2 m 的格子，能坐不能站', '格子没有门锁，只有帘子；贵重物品放储物柜', '大行李箱可能放不下，要寄存在前台', '男女分楼层，女性楼层少，要早订', '有的不能连住，每天都要退房再入住', '隔音差，会听到别人的声音'],
    fit: '一个人、行李少、不介意和别人共用浴室',
  },
  {
    jp: 'ネットカフェ', cn: '网咖（漫画咖啡）', tag: '只适合应急', tone: 'warn',
    pros: ['24 小时营业，按小时收费', '有包间或躺椅座位，有的能洗澡', '误了末班车时可以临时过夜'],
    cons: ['不是正规住宿，没有床', '第一次去要办会员，带上护照', '吵、亮，很难睡好'],
    fit: '误了末班车、临时找不到住处的时候',
  },
];

const sites = [
  { name: '携程 Trip.com', url: 'https://www.ctrip.com/', kind: ['机票', '酒店'], d: '中文界面，人民币付款，客服好联系。' },
  { name: '天巡 Skyscanner', url: 'https://www.tianxun.com/', kind: ['机票比价'], d: '一次比较很多家的价格，最后会跳到航空公司或代理商付款。' },
  { name: '航空公司官网', url: '', kind: ['机票'], d: '比价之后去官网再看一眼，有时更便宜，退改也更好办。' },
  { name: 'Booking.com', url: 'https://www.booking.com/', kind: ['酒店'], d: '日本酒店很多，很多房型可以免费取消。' },
  { name: 'Agoda', url: 'https://www.agoda.com/zh-cn/', kind: ['酒店'], d: '有中文，亚洲的酒店多，常有优惠。' },
  { name: 'じゃらん', url: 'https://www.jalan.net/', kind: ['酒店', '日文'], d: '日本本地网站，房源和价格有时更好，页面是日文。' },
  { name: '楽天トラベル', url: 'https://travel.rakuten.co.jp/', kind: ['酒店', '日文'], d: '日本本地网站，有不少只在这里卖的房型和套餐。' },
];
---

<Guide
  slug="flights-hotels"
  lead="先定日期，再挑机场；酒店尽量住九段下附近。各平台标的“最低价”条件都不一样，要比就比含税、含行李的总价。"
  toc={[
    { id: 'flight', label: '怎么选航班' },
    { id: 'airport', label: '羽田 vs 成田' },
    { id: 'book-flight', label: '机票下单' },
    { id: 'sites', label: '在哪里订' },
    { id: 'area', label: '住哪里' },
    { id: 'stay', label: '胶囊旅馆／网咖' },
    { id: 'book-hotel', label: '看懂房型' },
  ]}
>
  <Sec id="flight" idx="01" title="机票：先选日期，再选机场">
    <div class="prio reveal">
      {
        priority.map((p, i) => (
          <div class="prio-i">
            <span class="num">{i + 1}</span>
            {p}
          </div>
        ))
      }
    </div>
    <p class="small muted reveal">价格差不多的话，别为了省一点钱，选深夜到、要跑别的城市，或者演出当天才落地的航班。</p>
    <div class="grid grid-2">
      <div class="callout warn reveal">
        <strong>这两种安排别选</strong>
        ① 7 月 13 日当天才落地，下了飞机直接冲会场。② 演出当晚就要赶国际航班、末班新干线或夜间巴士。演出几点结束还不知道，太赶容易出事。<Ref n="02" />
      </div>
      <div class="callout reveal">
        <strong>红眼航班没有看上去那么便宜</strong>
        一大早落地，酒店可能还不能入住；半夜落地，可能已经没电车了。算价格时，把机场酒店、提前入住费、打车钱，还有累不累，都算进去。
      </div>
    </div>
  </Sec>

  <Sec id="airport" idx="02" title="羽田 HND 还是成田 NRT？">
    <div class="ap reveal">
      <svg viewBox="0 0 640 220" class="ap-svg" role="img" aria-label="羽田与成田相对东京市中心位置示意图">
        <defs>
          <linearGradient id="ap-g" x1="0" x2="1">
            <stop offset="0" stop-color="#ff3ac0"></stop><stop offset="1" stop-color="#3fb9ef"></stop>
          </linearGradient>
        </defs>
        <path d="M0 190 C120 170 220 200 330 175 S520 160 640 190 V220 H0Z" fill="#e2f5fd"></path>
        <text x="280" y="210" font-size="12" fill="#0a76a8">东京湾</text>
        <line x1="200" y1="80" x2="150" y2="160" stroke="#3fb9ef" stroke-width="5" stroke-dasharray="2 10" stroke-linecap="round"></line>
        <line x1="200" y1="80" x2="560" y2="60" stroke="#ff3ac0" stroke-width="5" stroke-dasharray="2 10" stroke-linecap="round"></line>
        <circle cx="200" cy="80" r="26" fill="url(#ap-g)"></circle>
        <text x="200" y="85" text-anchor="middle" fill="#fff" font-size="13" font-weight="700">市中心</text>
        <text x="200" y="40" text-anchor="middle" fill="#1e1530" font-size="12">九段下·武道馆</text>
        <g>
          <rect x="96" y="146" width="108" height="40" rx="20" fill="#3fb9ef"></rect>
          <text x="150" y="171" text-anchor="middle" fill="#fff" font-size="14" font-weight="700">羽田 HND</text>
        </g>
        <g>
          <rect x="506" y="40" width="108" height="40" rx="20" fill="#ff3ac0"></rect>
          <text x="560" y="65" text-anchor="middle" fill="#fff" font-size="14" font-weight="700">成田 NRT</text>
        </g>
        <text x="148" y="125" text-anchor="end" font-size="12" fill="#0a76a8">离市区近</text>
        <text x="380" y="58" text-anchor="middle" font-size="12" fill="#c0158c">离市区远，在千叶县</text>
      </svg>
      <p class="small muted" style="text-align:center">示意图，不按比例</p>
    </div>
    <div class="grid grid-2">
      <div class="card ap-card hnd reveal">
        <span class="chip blue">HND · Haneda</span>
        <h3>羽田机场</h3>
        <p class="small">坐京急或东京单轨电车进市区，看酒店在哪选路线。国际航班不一定都在 T3，看清机票上的航站楼。<Ref n="15" /></p>
      </div>
      <div class="card ap-card nrt reveal">
        <span class="chip">NRT · Narita</span>
        <h3>成田机场</h3>
        <p class="small">离市区比较远，可以坐 Skyliner、N'EX、Access Express 或机场巴士进城。<Ref n="16 17 18" /></p>
      </div>
    </div>
    <div class="callout warn reveal">
      <strong>别只看“到达东京”四个字</strong>
      东京有成田和羽田两个机场，离得很远，买票时看清楚是哪个。去程回程机场不一样的话，记清楚每段是 HND 还是 NRT。从大阪等地入境再去东京，要多花路费和时间，也更容易误事。
    </div>
  </Sec>

  <Sec id="book-flight" idx="03" title="买机票时看清这些">
    <div class="rows reveal">
      <div><dt>旅客姓名</dt><dd>和护照上的拼音一模一样，姓和名按页面提示填</dd></div>
      <div><dt>日期／时区</dt><dd>注意半夜起飞、第二天到的航班；机票上写的都是当地时间</dd></div>
      <div><dt>机场／航站楼</dt><dd>每段的机场和航站楼，中途要不要换机场、要不要入境</dd></div>
      <div><dt>运营方</dt><dd>看“实际承运”的是哪家航空公司，行李规定按它的来</dd></div>
      <div><dt>行李</dt><dd>能带多重的手提和托运行李？回来时周边装不装得下？</dd></div>
      <div><dt>额外费用</dt><dd>选座、行李、餐食、手续费都加上，再比价格</dd></div>
      <div><dt>退改签</dt><dd>改签要多少钱，能不能退</dd></div>
      <div><dt>转机保障</dt><dd>是不是一张票连着飞，行李能不能直挂，第一段晚点了谁负责改签</dd></div>
    </div>
    <div class="grid grid-2" style="margin-top:16px">
      <div class="callout tip reveal">
        <strong>付完钱，记得确认已经出票</strong>
        把订单号、航空公司的订位编号（PNR）存好，去航空公司官网查一下，看航班、姓名、行李都对不对。
      </div>
      <div class="callout reveal">
        <strong>充电宝和液体</strong>
        充电宝只能随身带，不能托运，JAL 还限制了数量和机上使用。随身带液体的话，每瓶不超过 100 mL，全部放进一个 1 L 以内的透明袋。出发前再看一下航空公司的最新规定。<Ref n="27" />
      </div>
    </div>
  </Sec>

  <Sec id="sites" idx="04" title="在哪里订机票和酒店">
    <p class="lead reveal">下面这些网站都可以用，本站没有收任何推广费。习惯用哪个就用哪个，<b>比价时看含税、含行李的总价</b>。</p>
    <div class="sites">
      {
        sites.map((x) => (
          <div class="site reveal">
            <div class="site-head">
              {x.url ? (
                <a href={x.url} target="_blank" rel="noopener">
                  {x.name} ↗
                </a>
              ) : (
                <b>{x.name}</b>
              )}
            </div>
            <div class="site-kind">
              {x.kind.map((k) => (
                <span class={`chip ${k === '日文' ? 'gray' : k.startsWith('机票') ? 'blue' : ''}`}>{k}</span>
              ))}
            </div>
            <p>{x.d}</p>
          </div>
        ))
      }
    </div>
    <div class="grid grid-2" style="margin-top:12px">
      <div class="callout reveal">
        <strong>比价网站上点“预订”，常会跳到别的代理商</strong>
        最后在哪家付款，退改就找哪家。付款前看清楚是航空公司官网、携程，还是不熟悉的小代理；太便宜的小代理，出了问题很难联系。
      </div>
      <div class="callout warn reveal">
        <strong>签证没下来前，只订能免费取消的</strong>
        订酒店时选“免费取消”的房型，看清楚最晚哪天能免费取消。如果签证要求机酒由旅行社安排，先问旅行社再订。
      </div>
    </div>
  </Sec>

  <Sec id="area" idx="05" title="酒店住哪里：以九段下为中心">
    <div class="split">
      <div class="areamap reveal">
        <svg viewBox="0 0 560 400" role="img" aria-label="九段下周边酒店区域示意图">
          <defs>
            <radialGradient id="am-glow"><stop offset="0" stop-color="#ff3ac0" stop-opacity="0.35"></stop><stop offset="1" stop-color="#ff3ac0" stop-opacity="0"></stop></radialGradient>
          </defs>
          <circle cx="300" cy="200" r="150" fill="none" stroke="#ebe5f3" stroke-dasharray="4 6"></circle>
          <circle cx="300" cy="200" r="80" fill="none" stroke="#ebe5f3" stroke-dasharray="4 6"></circle>
          <circle cx="300" cy="200" r="90" fill="url(#am-glow)"></circle>
          <!-- metro lines (schematic) -->
          <path d="M96 186 L300 200 L382 238" stroke="#6cbb5a" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.8"></path>
          <path d="M120 330 L300 207 L380 246" stroke="#8f76d6" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.8"></path>
          <path d="M262 104 L300 200 L470 300" stroke="#009bbf" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.8"></path>
          {
            areas.map((a) => (
              <g class={`am-node ${a.main ? 'main' : ''}`}>
                <circle cx={a.x} cy={a.y} r={a.r} fill={a.main ? '#ff3ac0' : '#fff'} stroke={a.main ? '#fff' : '#3fb9ef'} stroke-width="4" />
                <text x={a.x} y={a.y + a.r + 18} text-anchor="middle" font-size="14" font-weight="700" fill="#1e1530">
                  {a.name}
                </text>
              </g>
            ))
          }
          <text x="300" y="206" text-anchor="middle" font-size="13" font-weight="800" fill="#fff">武道馆</text>
          <g font-size="11" fill="#7a7190">
            <rect x="12" y="12" width="12" height="4" fill="#6cbb5a"></rect><text x="30" y="18">都营新宿线</text>
            <rect x="12" y="28" width="12" height="4" fill="#8f76d6"></rect><text x="30" y="34">半藏门线</text>
            <rect x="12" y="44" width="12" height="4" fill="#009bbf"></rect><text x="30" y="50">东西线</text>
          </g>
        </svg>
        <p class="small muted" style="text-align:center">示意图：九段下有东西线、半藏门线、都营新宿线三条线经过，不按实际比例</p>
      </div>
      <div class="area-list">
        {
          areas.map((a) => (
            <div class={`al reveal ${a.main ? 'main' : ''}`}>
              <b>{a.name}</b>
              <span>{a.d}</span>
            </div>
          ))
        }
        <p class="small muted">线路依据官方地铁线路图 <Ref n="19" /></p>
      </div>
    </div>

    <div class="callout tip reveal">
      <strong>挑酒店的顺序</strong>
      去会场、回机场方便 → 价格能接受 → 能免费取消 → 房型和大小 → 有没有早餐。2027 年 7 月的房间可能还没开放预订，看不到房不一定是满了，过段时间再看。
    </div>
  </Sec>

  <Sec id="stay" idx="06" title="除了酒店，还有胶囊旅馆和网咖">
    <p class="lead reveal">日本有两种比较特别的住法：胶囊旅馆和网咖。便宜，但和普通酒店差别很大，先了解清楚再决定。</p>
    <div class="stays">
      {
        stays.map((st) => (
          <div class={`stay reveal tone-${st.tone}`}>
            <div class="stay-head">
              <span class={`chip ${st.tone}`}>{st.tag}</span>
              <h3>
                <span lang="ja">{st.jp}</span>
                <small>{st.cn}</small>
              </h3>
            </div>
            <ul class="pc-list">
              {st.pros.map((x) => (
                <li class="pro">{x}</li>
              ))}
              {st.cons.map((x) => (
                <li class="con">{x}</li>
              ))}
            </ul>
            <p class="stay-fit">
              <b>适合：</b>
              {st.fit}
            </p>
          </div>
        ))
      }
    </div>
    <div class="capsule-art reveal" aria-hidden="true">
      <svg viewBox="0 0 520 150">
        <rect x="0" y="0" width="520" height="150" rx="16" fill="#f4f0fa"></rect>
        {[0, 1].map((row) => [0, 1, 2, 3].map((c) => (
          <g transform={`translate(${30 + c * 118} ${18 + row * 64})`}>
            <rect width="104" height="54" rx="12" fill="#fff" stroke="#d6cce4" stroke-width="2" />
            <ellipse cx="26" cy="27" rx="16" ry="18" fill={(row + c) % 3 === 0 ? '#ffe6f6' : '#1e1530'} stroke="#d6cce4" stroke-width="2" />
            <rect x="52" y="20" width="40" height="14" rx="4" fill="#e2f5fd" />
          </g>
        )))}
      </svg>
      <p class="small muted" style="text-align:center;margin:6px 0 0">胶囊旅馆示意：一个个上下两层的小格子，每格只够躺下</p>
    </div>
    <div class="callout warn reveal">
      <strong>演出前后两晚，建议住正规酒店</strong>
      看完演出很累，第二天还可能要赶飞机，睡好最重要。胶囊旅馆可以用来省其他几晚的钱，网咖只在误了末班车时临时用一下。
    </div>
  </Sec>

  <Sec id="book-hotel" idx="07" title="看懂日本酒店的房型">
    <p class="lead reveal">日本的订房网站一般用日文写房型。记住下面这几个词，再看<b>床宽</b>和<b>住几个人</b>，就不会订错。</p>
    <div class="rooms">
      {
        rooms.map((r) => (
          <div class="room reveal">
            <svg viewBox="0 0 120 80" aria-hidden="true">
              <rect x="4" y="4" width="112" height="72" rx="10" fill={r.bed === 'washitsu' ? '#eef6e4' : '#faf7fd'} stroke="#ebe5f3" />
              {r.bed === 'single' && <g><rect x="44" y="14" width="32" height="54" rx="6" fill="#e2f5fd" stroke="#3fb9ef" stroke-width="2" /><rect x="50" y="18" width="20" height="10" rx="4" fill="#fff" stroke="#3fb9ef" /></g>}
              {r.bed === 'semi' && <g><rect x="38" y="14" width="44" height="54" rx="6" fill="#e2f5fd" stroke="#3fb9ef" stroke-width="2" /><rect x="46" y="18" width="28" height="10" rx="4" fill="#fff" stroke="#3fb9ef" /></g>}
              {r.bed === 'double' && <g><rect x="30" y="14" width="60" height="54" rx="6" fill="#e2f5fd" stroke="#3fb9ef" stroke-width="2" /><rect x="35" y="18" width="23" height="10" rx="4" fill="#fff" stroke="#3fb9ef" /><rect x="62" y="18" width="23" height="10" rx="4" fill="#fff" stroke="#3fb9ef" /></g>}
              {r.bed === 'twin' && <g><rect x="20" y="14" width="32" height="54" rx="6" fill="#ffe6f6" stroke="#ff3ac0" stroke-width="2" /><rect x="26" y="18" width="20" height="10" rx="4" fill="#fff" stroke="#ff3ac0" /><rect x="68" y="14" width="32" height="54" rx="6" fill="#ffe6f6" stroke="#ff3ac0" stroke-width="2" /><rect x="74" y="18" width="20" height="10" rx="4" fill="#fff" stroke="#ff3ac0" /></g>}
              {r.bed === 'triple' && <g>{[12, 44, 76].map((x) => <g><rect x={x} y="14" width="28" height="54" rx="6" fill="#ffe6f6" stroke="#ff3ac0" stroke-width="2" /><rect x={x + 5} y="18" width="18" height="10" rx="4" fill="#fff" stroke="#ff3ac0" /></g>)}</g>}
              {r.bed === 'washitsu' && <g><path d="M10 40h100M40 8v64M80 8v64" stroke="#c9dcae" stroke-width="2" /><rect x="16" y="16" width="26" height="48" rx="4" fill="#fff" stroke="#7bab4a" stroke-width="2" /><rect x="47" y="16" width="26" height="48" rx="4" fill="#fff" stroke="#7bab4a" stroke-width="2" /><rect x="78" y="16" width="26" height="48" rx="4" fill="#fff" stroke="#7bab4a" stroke-width="2" /></g>}
            </svg>
            <b class="room-jp" lang="ja">{r.jp}</b>
            <span class="room-sub">{r.en} · {r.cn}</span>
            <div class="room-facts">
              <span class="chip blue">{r.width}</span>
              <span class="chip">{r.ppl}</span>
            </div>
            <p>{r.d}</p>
          </div>
        ))
      }
    </div>

    <h3 class="reveal" style="margin-top:28px">房型页面上常见的日文</h3>
    <div class="terms">
      {
        terms.map((t) => (
          <div class="term reveal">
            <b lang="ja">{t.jp}</b>
            <span>{t.cn}</span>
            <small>{t.d}</small>
          </div>
        ))
      }
    </div>
    <div class="callout reveal">
      <strong>东京的房间普遍很小</strong>
      两个人带两个大行李箱，在商务酒店的小房间里可能都打不开。看清楚房间面积（㎡），朋友合住的话尽量选 ツイン，或者面积大一点的房间。
    </div>
    <div class="grid grid-2" style="margin-top:12px">
      <div class="card reveal small"><b>Non-refundable</b> <span class="jpk" lang="ja">返金不可</span><p>订了就不能退（或者很难退）。和“到店付款”不一样。</p></div>
      <div class="card reveal small"><b>Pay at property</b> <span class="jpk" lang="ja">現地払い</span><p>到酒店再付钱，但可能要先留信用卡，临时取消或没去也可能扣钱。</p></div>
    </div>

    <h3 class="reveal" style="margin-top:28px">跨午夜入住：订的是哪一晚？</h3>
    <div class="night reveal">
      <div class="nt day"><b class="num">7/11</b><small>晚上航班落地</small></div>
      <div class="nt mid"><b class="num">00:00</b></div>
      <div class="nt day2"><b class="num">7/12 01:00</b><small>到前台</small></div>
      <div class="nt-res">→ 通常要订的是 <b>7/11 这一晚</b>，并提前告诉酒店预计几点到</div>
    </div>
    <p class="small reveal">
      反过来，7/12 一大早落地、只订了 7/12 晚上的话，早上是进不了房间的。可以问问酒店能不能提前入住（可能要加钱），或者先寄存行李。
    </p>

    <div class="split" style="margin-top:20px">
      <div class="callout tip reveal">
        <strong>把订单存成能直接给人看的样子</strong>
        酒店日文名、完整地址、电话、订单号、入住人姓名、免费取消截止时间。每个同伴都存一份。入住时带上护照。
      </div>
      <div class="msg-card reveal">
        <p class="small muted" style="margin:0 0 6px">入住沟通模板</p>
        <p lang="en">I have a reservation under <b>[护照姓名]</b>. My booking number is <b>[编号]</b>.<br />I expect to arrive at around <b>[日期＋时间]</b>. Could you confirm late check-in?</p>
        <p class="small muted" style="margin:10px 0 6px">日语版（日本的酒店更好懂）</p>
        <p lang="ja" class="jp">［护照姓名］の名前で予約しています。予約番号は［编号］です。<br />到着は［日期・时间］ごろになります。遅い時間のチェックインは大丈夫でしょうか。</p>
      </div>
    </div>
    <p class="small muted reveal">签证还没下来的话，先订能免费取消的房间。如果签证要求机酒由旅行社订，订之前、改之前都先问旅行社。<Ref n="09 10" /></p>
  </Sec>
</Guide>

