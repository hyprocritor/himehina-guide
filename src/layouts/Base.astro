---
import Glyph from '../components/Glyph.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/islands.css';
import Icon from '../components/Icon.astro';
import { sections, EVENT } from '../data/sections';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = 'HIMEHINA 2027 日本武道馆公演·中国大陆观众首次赴日观演攻略：抽票、护照、签证、机酒、交通、支付、物贩与演出当天。',
  current,
} = Astro.props;
const fullTitle = current ? `${title}｜HIMEHINA 武道馆赴日攻略` : title;
const cur = sections.find((s) => s.slug === current);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfaff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#120e1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline src="https://trace.auv.lu/api/script.js?siteId=ab81ab67dbf4" defer></script>
    <script is:inline>
      // Hide the upgrade banner before first paint if the visitor dismissed it.
      try {
        if (localStorage.getItem('hh-upgrade-banner') === 'v1') document.documentElement.dataset.upgradeHidden = '1';
      } catch (e) {}
      // Apply the saved theme before first paint (auto = follow the system).
      try {
        var t = localStorage.getItem('hh-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="sr-only" href="#main">跳到正文</a>
    <header class="site-header" transition:persist="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="返回首页">
          <span class="brand-mark" aria-hidden="true">
            <i></i><i></i>
          </span>
          <span class="brand-text">
            <b>HIMEHINA</b>
            <small><span class="bt-long">非官方 · 武道馆赴日攻略</span><span class="bt-short">非官方赴日攻略</span></small>
          </span>
        </a>

        <a class="here" href={cur ? `/${cur.slug}/` : '/'} data-here hidden={!cur}>
          <span class="num" data-here-no>{cur?.no}</span>
          <span data-here-title>{cur?.title}</span>
        </a>

        <div class="bar-right">
          <span class="bar-date num" aria-label="演出日期">2027.07.13</span>
          <button class="theme-btn" type="button" data-theme-btn aria-label="切换深色／浅色模式" title="切换深色／浅色模式">
            <svg class="ti ti-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path></svg>
            <svg class="ti ti-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <svg class="ti ti-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"></path></svg>
            <span class="theme-label" data-theme-label>自动</span>
          </button>
          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
            <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="menu-label">目录</span>
          </button>
        </div>
      </div>
      <div class="progress" aria-hidden="true"><i data-progress></i></div>

      <div class="menu" id="site-menu" data-menu hidden>
        <div class="menu-scrim" data-menu-close></div>
        <nav class="menu-panel" aria-label="全部章节">
          <div class="menu-head">
            <b>全部章节</b>
            <button type="button" class="menu-x" aria-label="关闭目录" data-menu-close><Glyph name="x" /></button>
          </div>
          <div class="menu-grid">
            <a href="/" data-slug="" class="mi home">
              <span class="mi-ic"><Icon name="stage" size={30} /></span>
              <span class="mi-t"><small class="num">HOME</small><b>首页</b></span>
            </a>
            {
              sections.map((s) => (
                <a href={`/${s.slug}/`} data-slug={s.slug} class="mi">
                  <span class="mi-ic">
                    <Icon name={s.icon} size={30} />
                  </span>
                  <span class="mi-t">
                    <small class="num">
                      {s.no} · {s.en}
                    </small>
                    <b>{s.title}</b>
                  </span>
                </a>
              ))
            }
          </div>
          <a class="menu-up" href="/tickets/#upgrade">
            <span class="chip">待公布</span> 升级席会后续开放，细节还没公布 <Glyph name="arrow-right" />
          </a>
        </nav>
      </div>
    </header>

    <div class="upgrade-bar" data-upgrade-bar>
      <div class="wrap ub-inner">
        <span class="ub-dot" aria-hidden="true"></span>
        <p>
          <b>升级席（アップグレード）将后续开放</b><span class="ub-more">：价格、内容和申请方式都还没公布。</span>
          <a href="/tickets/#upgrade">查看说明 <Glyph name="arrow-right" /></a>
        </p>
        <button type="button" class="ub-x" aria-label="不再显示此通知" data-upgrade-close><Glyph name="x" /></button>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="foot-glow" aria-hidden="true"></div>
      <div class="wrap foot">
        <div class="foot-main">
          <a class="foot-brand" href="/">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i></span>
            <span>
              <b class="grad-text">HIMEHINA</b>
              <small>武道馆 2027 · 首次赴日观演攻略</small>
            </span>
          </a>
          <p class="foot-desc">
            由粉丝整理的非官方攻略，和主办方、Lawson、使领馆、旅行社都没有关系。资料整理于 {EVENT.checked}，规定可能会变，出发前请再看一眼<a href="/sources/">官方来源</a>。
          </p>
          <div class="foot-live">
            <iframe
              data-live-widget="https://trace.auv.lu/widget/ab81ab67dbf4?variant=inline"
              title="Live visitors"
              loading="lazy"
              scrolling="no"></iframe>
          </div>
        </div>

        <nav class="foot-nav" aria-label="页脚章节导航">
          <p class="foot-h">章节</p>
          <ul>
            {
              sections.map((s) => (
                <li>
                  <a href={`/${s.slug}/`}>
                    <span class="num">{s.no}</span>
                    {s.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="wrap foot-bottom">
        <p class="foot-author">
          编写：<b>HIMEHINA 远征部</b>
        </p>
        <p class="foot-license">
          <a class="cc" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="license noopener" aria-label="CC BY-NC-SA 4.0 许可协议">
            <span class="cc-badge" aria-hidden="true"><b>cc</b><i>BY</i><i>NC</i><i>SA</i></span>
          </a>
          <span>
            <b class="lic-1">本站内容采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="license noopener">CC BY-NC-SA 4.0</a> 许可</b>
          </span>
        </p>
      </div>
    </footer>

    <script>
      import { sections } from '../data/sections';

      const menu = () => document.querySelector<HTMLElement>('[data-menu]');
      const btn = () => document.querySelector<HTMLButtonElement>('[data-menu-btn]');

      function openMenu(open: boolean) {
        const m = menu();
        const b = btn();
        if (!m || !b) return;
        b.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('menu-open', open);
        if (open) {
          m.hidden = false;
          requestAnimationFrame(() => m.classList.add('show'));
          m.querySelector<HTMLElement>('a[aria-current]')?.focus({ preventScroll: true });
        } else {
          m.classList.remove('show');
          setTimeout(() => {
            if (!m.classList.contains('show')) m.hidden = true;
          }, 250);
        }
      }

      // The header is persisted across view transitions, so wire its listeners only once.
      let wired = false;
      function wireHeader() {
        if (wired) return;
        wired = true;
        btn()?.addEventListener('click', () => openMenu(btn()?.getAttribute('aria-expanded') !== 'true'));
        document.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => openMenu(false)));
        menu()?.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) openMenu(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') openMenu(false);
        });
        // Theme switch: auto → dark → light → auto
        const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-btn]');
        const labels: Record<string, string> = { auto: '自动', dark: '深色', light: '浅色' };
        const getTheme = () => {
          try {
            const t = localStorage.getItem('hh-theme');
            return t === 'light' || t === 'dark' ? t : 'auto';
          } catch {
            return 'auto';
          }
        };
        const showTheme = (t: string) => {
          if (!themeBtn) return;
          themeBtn.dataset.mode = t;
          const l = themeBtn.querySelector('[data-theme-label]');
          if (l) l.textContent = labels[t];
          themeBtn.setAttribute('aria-label', `主题：${labels[t]}（点击切换）`);
        };
        showTheme(getTheme());
        themeBtn?.addEventListener('click', () => {
          const next = { auto: 'dark', dark: 'light', light: 'auto' }[getTheme()]!;
          try {
            if (next === 'auto') localStorage.removeItem('hh-theme');
            else localStorage.setItem('hh-theme', next);
          } catch {}
          if (next === 'auto') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = next;
          showTheme(next);
        });

        const bar = document.querySelector<HTMLElement>('[data-progress]');
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        };
        addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('astro:page-load', onScroll);
      }

      // Realtime visitor widget: follow the site theme (auto = system setting).
      const darkMq = matchMedia('(prefers-color-scheme: dark)');
      function syncLiveWidget() {
        const f = document.querySelector<HTMLIFrameElement>('[data-live-widget]');
        if (!f) return;
        const t = document.documentElement.dataset.theme;
        const theme = t === 'dark' || (t !== 'light' && darkMq.matches) ? 'dark' : 'light';
        const src = `${f.dataset.liveWidget}&theme=${theme}`;
        // Matching color-scheme keeps the iframe background transparent.
        f.style.colorScheme = theme;
        if (f.getAttribute('src') !== src) f.setAttribute('src', src);
      }
      new MutationObserver(syncLiveWidget).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      darkMq.addEventListener('change', syncLiveWidget);

      function setup() {
        syncLiveWidget();
        wireHeader();
        openMenu(false);

        // Current chapter in the persisted header.
        const slug = location.pathname.split('/').filter(Boolean)[0] ?? '';
        const cur = sections.find((s) => s.slug === slug);
        const here = document.querySelector<HTMLAnchorElement>('[data-here]');
        if (here) {
          here.hidden = !cur;
          if (cur) {
            here.href = `/${cur.slug}/`;
            here.querySelector('[data-here-no]')!.textContent = cur.no;
            here.querySelector('[data-here-title]')!.textContent = cur.title;
          }
        }
        document.querySelectorAll<HTMLAnchorElement>('.menu-grid a').forEach((a) => {
          if (a.dataset.slug === slug) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });

        // Upgrade banner dismissal (the banner is re-rendered on every page).
        let hidden = false;
        try {
          hidden = localStorage.getItem('hh-upgrade-banner') === 'v1';
        } catch {}
        if (hidden) document.documentElement.dataset.upgradeHidden = '1';
        document.querySelector('[data-upgrade-close]')?.addEventListener('click', () => {
          document.documentElement.dataset.upgradeHidden = '1';
          try {
            localStorage.setItem('hh-upgrade-banner', 'v1');
          } catch {}
        });

        // Reveal blocks on scroll.
        const els = document.querySelectorAll('.reveal:not(.in)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setup);
      // Astro swaps <html> attributes on navigation; restore the dismissal flag before paint.
      document.addEventListener('astro:after-swap', () => {
        try {
          if (localStorage.getItem('hh-upgrade-banner') === 'v1') document.documentElement.dataset.upgradeHidden = '1';
          const t = localStorage.getItem('hh-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }

  .brand-mark {
    position: relative;
    width: 34px;
    height: 34px;
  }

  .brand-mark i {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    mix-blend-mode: multiply;
  }

  /* multiply turns the overlap black on dark backgrounds */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-mark i {
      mix-blend-mode: screen;
    }
  }

  :global(:root[data-theme='dark']) .brand-mark i {
    mix-blend-mode: screen;
  }

  .brand-mark i:first-child {
    background: var(--pink);
    left: 0;
    top: 6px;
  }

  .brand-mark i:last-child {
    background: var(--blue);
    right: 0;
    top: 6px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text b {
    font: 800 1.05rem/1.1 var(--font-display);
    letter-spacing: 0.06em;
  }

  .brand-text small {
    font-size: 0.74rem;
    color: var(--ink-3);
  }

  .here {
    min-width: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--inverse);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .here[hidden] {
    display: none;
  }

  .here .num {
    color: var(--pink);
    font-size: 0.74rem;
  }

  .bar-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bar-date {
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--pink-ink);
  }

  .bt-short {
    display: none;
  }

  @media (max-width: 520px) {
    .bar-date,
    .bt-long {
      display: none;
    }
    .bt-short {
      display: inline;
    }
    .brand {
      gap: 8px;
    }
    .brand-mark {
      width: 28px;
      height: 28px;
    }
    .brand-mark i {
      width: 18px;
      height: 18px;
    }
    .brand-text b {
      font-size: 0.95rem;
    }
    .brand-text small {
      font-size: 0.66rem;
    }
    .menu-btn {
      padding: 8px 11px;
    }
    .menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .here {
      font-size: 0.8rem;
      padding: 4px 10px;
    }
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    flex: none;
  }

  .theme-btn:hover {
    border-color: var(--pink);
  }

  .theme-btn .ti {
    width: 18px;
    height: 18px;
    display: none;
  }

  .theme-btn[data-mode='auto'] .ti-auto,
  .theme-btn[data-mode='light'] .ti-light,
  .theme-btn[data-mode='dark'] .ti-dark,
  .theme-btn:not([data-mode]) .ti-auto {
    display: block;
  }

  @media (max-width: 520px) {
    .theme-label {
      display: none;
    }
    .theme-btn {
      width: 38px;
      padding: 0;
      justify-content: center;
    }
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font: inherit;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    cursor: pointer;
    flex: none;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .menu-btn:hover {
    border-color: var(--pink);
  }

  .menu-btn[aria-expanded='true'] {
    background: var(--inverse);
    color: #fff;
    border-color: var(--inverse);
  }

  .burger {
    position: relative;
    width: 16px;
    height: 12px;
  }

  .burger i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.25s,
      opacity 0.25s;
  }

  .burger i:nth-child(1) {
    top: 0;
  }

  .burger i:nth-child(2) {
    top: 5px;
  }

  .burger i:nth-child(3) {
    top: 10px;
  }

  .menu-btn[aria-expanded='true'] .burger i:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .burger i:nth-child(2) {
    opacity: 0;
  }

  .menu-btn[aria-expanded='true'] .burger i:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
  }

  .progress i {
    display: block;
    height: 100%;
    background: var(--grad);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* ── Menu ── */
  .menu {
    position: fixed;
    inset: 60px 0 0;
    z-index: 60;
  }

  .menu[hidden] {
    display: none;
  }

  .menu-scrim {
    position: absolute;
    inset: 0;
    touch-action: none;
    background: rgb(30 21 48 / 0.35);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .menu-panel {
    position: relative;
    width: min(100% - 24px, 860px);
    margin: 10px auto 0;
    max-height: calc(100dvh - 90px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    padding: 16px;
    opacity: 0;
    transform: translateY(-10px) scale(0.98);
    transition:
      opacity 0.25s,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .menu.show .menu-scrim {
    opacity: 1;
  }

  .menu.show .menu-panel {
    opacity: 1;
    transform: none;
  }

  .menu-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .menu-x {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
    font-size: 0.9rem;
  }

  .menu-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }

  .mi {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 0.2s,
      background 0.2s,
      transform 0.2s;
  }

  .mi:hover {
    border-color: var(--pink);
    transform: translateY(-1px);
  }

  .mi[aria-current='page'] {
    background: var(--inverse);
    border-color: var(--inverse);
    color: #fff;
  }

  .mi[aria-current='page'] small {
    color: var(--pink);
  }

  .mi-ic {
    flex: none;
    width: 44px;
    height: 44px;
