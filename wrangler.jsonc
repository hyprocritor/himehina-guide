{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himehina-budokan-guide",
  "compatibility_date": "2026-10-01",
  // Static site: Astro builds to ./dist and Workers serves it as static assets (no Worker script needed).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
